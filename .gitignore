node_modules/
dist/
test-results/
playwright-report/
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example

# Local model weights (download separately, ~1.4 GB)
google_embeddinggemma_2/

# Raw datasets (multi-GB, build-time only). Only derived server/*.npz is tracked.
# indian_food_dataset_4 stays tracked (it has committed crawl source); its own
# datasets/indian_food_dataset_4/.gitignore excludes its large data/ and caches.
datasets/*
!datasets/indian_food_dataset_4/

# Python backend
__pycache__/
*.pyc
.venv/
venv/

# Derived label-embedding cache (rebuilt on startup from the committed labels)
server/label_emb_cache.npz

# Large rebuilt artifact (baked into the deploy image via .gcloudignore)
server/*.npz

# Local scratch / provider-migration backups — never commit
server/_local_space/
server/*.vertex*.npz
